{
  "name": "cv-project",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "envs": "node set-envs.js",
    "build": "npm run envs && ng build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "compodoc": "npx compodoc -p tsconfig.doc.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.3.19",
    "@angular/compiler": "20.3.19",
    "@angular/core": "20.3.19",
    "@angular/forms": "20.3.19",
    "@angular/platform-browser": "20.3.19",
    "@angular/router": "20.3.19",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@popperjs/core": "^2.11.8",
    "animate.css": "^4.1.1",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "7.8.0",
    "tslib": "2.3.0",
    "zone.js": "0.15.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@angular/build": "20.3.19",
    "@angular/cli": "20.3.19",
    "@angular/compiler-cli": "20.3.19",
    "@angular/localize": "20.3.19",
    "@compodoc/compodoc": "1.1.32",
    "@faker-js/faker": "10.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-html-reporters": "3.1.7",
    "jest-preset-angular": "15.0.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.2"
  }
